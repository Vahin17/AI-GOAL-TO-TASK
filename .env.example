LLM_PROVIDER=gemini
MODEL_NAME=gemini-1.5-pro

GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=ai_goal_planner

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

FRONTEND_URL=http://localhost:3000

ENVIRONMENT=development
DEBUG=true

# Comma-separated list for origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

LOG_LEVEL=INFO

ENABLE_FALLBACK_RULES=true
ENABLE_EXECUTION_ENGINE=true
ENABLE_MEMORY_LAYER=true

# Authentication & Session Persistence (PostgreSQL)
AUTH_DB_BACKEND=postgres # "postgres" (production authoritative) or "sqlite" (isolated test suites only)
POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/ai_goal_planner
SESSION_COOKIE_NAME=ardo_session
SESSION_DURATION_DAYS=7
COOKIE_SECURE=false # Set to true in production with HTTPS
COOKIE_SAMESITE=lax # "lax" for standard development/production; "none" if cross-subdomain HTTPS
COOKIE_DOMAIN=

# CSRF Protection: Trusted frontend origins for state-changing requests
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional OAuth 2.0 Providers (Leave blank unless valid credentials are configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/auth/facebook/callback

# Phase 4 Production Hardening & Egress Controls
ENABLE_RATE_LIMITING=true
RATE_LIMIT_PLAN_PER_MINUTE=15
RATE_LIMIT_ORCHESTRATE_PER_MINUTE=10
MAX_PAYLOAD_BYTES=2097152
MAX_ACTIVE_SESSIONS_PER_USER=3
MAX_GLOBAL_CONCURRENT_TASKS=10
TASK_EXECUTION_TIMEOUT_SECONDS=120.0
BROWSER_ACTION_TIMEOUT_SECONDS=30.0
AI_CALL_TIMEOUT_SECONDS=45.0
STRUCTURED_LOGGING=false
BROWSER_EGRESS_PROXY=http://localhost:3128 # Point to Squid egress proxy in production
